# Credentials and local config — never commit
.env
config.yaml

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Data and outputs — large files stay local (top-level dirs only)
/data/
/outputs/
/features/
/models/
/predictions/

# OS
.DS_Store

# SLURM job logs.  The directory itself is tracked via logs/.gitkeep because
# sbatch opens --output before the job body runs, so a missing logs/ kills the
# job with no log explaining why.
logs/*
!logs/.gitkeep
